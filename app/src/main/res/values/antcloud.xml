<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="antcloud_blue">#4A86E8</color>
    <color name="antcloud_window">#F7F8FA</color>

    <!-- The AntCloud panel draws everything in Compose; this only sets the window before it does. -->
    <style name="AntCloudTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/antcloud_window</item>
        <item name="android:colorAccent">@color/antcloud_blue</item>
    </style>
</resources>
