<?xml version="1.0" encoding="utf-8"?>
<!-- AntCloud launcher icon: the logo on brand blue, so the launcher's mask trims into blue. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/antcloud_blue" />
    <foreground>
        <inset android:drawable="@drawable/antcloud_logo" android:inset="17%" />
    </foreground>
</adaptive-icon>
